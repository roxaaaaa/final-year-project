# Model Settings



# If using local Ollama: http://localhost:11434/v1

# If using a cloud provider: https://api.groq.com/openai/v1

OLLAMA_BASE_URL=http://localhost:11434/v1

# If Ollama is unreachable, question generation falls back to OpenAI using CHATGPT_MODEL (requires OPENAI_API_KEY).

MODEL_NAME=llama3.1:8b

CHATGPT_MODEL=gpt-4o-mini

# Security

# API key for OpenAI (required if not using local Ollama)

OPENAI_API_KEY=your-openai-api-key



# D-ID — teacher avatar videos on the practice page (optional; feedback text still works without it)

DID_API_KEY=your-d-id-api-key

# Video on, but use Talks (photo avatar) unless your key has clips:write for Pro presenters.
DID_CLIPS_ENABLED=true
DID_VIDEO_MODE=talks

# Alternative: DID_VIDEO_MODE=clips (requires D-ID plan with clips:write).

# HTTPS image URL for Talks only (jpg/png). Default is D-ID sample "Alice".
# DID_TALK_SOURCE_URL=https://d-id-public-bucket.s3.us-west-2.amazonaws.com/alice.jpg

# Turn off all D-ID video (text feedback only): DID_CLIPS_ENABLED=false

# Optional override; default presenter if unset:

# DID_PRESENTER_ID=v2_public_Amber@0zSz8kflCN

# Optional API host override:

# DID_BASE_URL=https://api.d-id.com



# Google OAuth Configuration
# Cloud Console → Credentials → Web client:
#   Authorized redirect URIs: https://<your-render-host>/auth/google/callback
#   Authorized JavaScript origins: https://<your-vercel-host> (and http://localhost:3000 for local UI)

GOOGLE_CLIENT_ID=your-google-oauth-client-id

GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

JWT_SECRET=your-jwt-secret-key

SESSION_SECRET=your-session-secret-key

# Browser origin for CORS and post-Google-OAuth redirect (no trailing slash).
# Local:
FRONTEND_URL=http://localhost:3000
# Production (Render backend + Vercel UI example): set only in Render env, not committed.
# FRONTEND_URL=https://your-app.vercel.app

# Neon / Postgres async URL (required on Render). Use postgresql+asyncpg:// not postgresql://
# Pooler host: database.py disables asyncpg statement cache for PgBouncer compatibility.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Optional: force Secure session cookies when not on Render (default: Secure if RENDER=true)
# SESSION_COOKIE_SECURE=1

# Server Settings

PORT=8000

DEBUG=True

